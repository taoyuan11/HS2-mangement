<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <WindowsAppSDKDeploymentManagerInitialize>false</WindowsAppSDKDeploymentManagerInitialize>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><AssemblyName>HS2Manager.LegacyApp</AssemblyName><IsPublishable>false</IsPublishable>
    <ApplicationManifest>app.manifest</ApplicationManifest><Version>1.2.0-preview.2</Version>
    <ApplicationIcon>Assets\Brand\hs2-manager.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../../src/HS2Manager.Core/HS2Manager.Core.csproj" /></ItemGroup>
  <ItemGroup><ProjectReference Include="../../src/HS2Manager.Rendering/HS2Manager.Rendering.csproj" /></ItemGroup>
  <ItemGroup><ProjectReference Include="../../src/HS2Manager.Export/HS2Manager.Export.csproj" /></ItemGroup>
  <ItemGroup><PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" /></ItemGroup>
  <ItemGroup>
    <Content Include="Assets\Brand\hs2-manager.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\Brand\hs2-manager.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- The .NET 10 unpackaged publish pipeline must carry generated XAML and its PRI index. -->
  <Target Name="IncludeWinUiResourcesInPublish" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <_WinUiXamlFiles Include="$(TargetDir)**\*.xbf" />
      <ResolvedFileToPublish Include="@(_WinUiXamlFiles)">
        <RelativePath>%(_WinUiXamlFiles.RecursiveDir)%(_WinUiXamlFiles.Filename)%(_WinUiXamlFiles.Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
      <ResolvedFileToPublish Include="$(TargetDir)$(AssemblyName).pri">
        <RelativePath>$(AssemblyName).pri</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
    <Error Condition="!Exists('$(TargetDir)$(AssemblyName).pri')" Text="WinUI resource index is missing; build before publishing." />
  </Target>
  <ItemGroup><ProjectReference Include="../HS2Manager.LegacyPreview/HS2Manager.LegacyPreview.csproj" /></ItemGroup>
</Project>

<Window x:Class="HS2Manager.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:HS2Manager.App" Title="HS2 Manager">
 <Grid x:Name="Root" Background="{ThemeResource PageBrush}" AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver" KeyDown="Window_KeyDown">
 <Grid.Resources>
  <DataTemplate x:Key="CardTemplate">
   <Grid Margin="6,5,6,7">
    <Grid.RowDefinitions><RowDefinition Height="240"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border CornerRadius="9" Background="{ThemeResource SidebarBrush}">
     <Grid><TextBlock Text="▧" FontSize="36" Foreground="{ThemeResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      <Image Source="{Binding Cover}" Stretch="Uniform"/>
      <Border Background="#D9252928" CornerRadius="5" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Padding="6,2" Visibility="{Binding Favorite, Converter={StaticResource BoolVisible}}"><TextBlock Text="★" Foreground="#F0D58D" FontSize="12"/></Border>
     </Grid>
    </Border>
    <StackPanel Grid.Row="1" Margin="2,9,0,0"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Name}"/><TextBlock Text="{Binding Subtitle}" Foreground="{ThemeResource MutedBrush}" FontSize="11" Margin="0,4,0,0"/></StackPanel>
   </Grid>
  </DataTemplate>
  <Style x:Key="CardContainer" TargetType="GridViewItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="3"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
  <DataTemplate x:Key="FolderTemplate" x:DataType="local:FolderNode">
   <TreeViewItem ItemsSource="{x:Bind Children}" IsExpanded="{x:Bind Expanded, Mode=TwoWay}">
    <TextBlock Text="{x:Bind Name}" ToolTipService.ToolTip="{x:Bind Path}" TextTrimming="CharacterEllipsis" FontSize="12"/>
   </TreeViewItem>
  </DataTemplate>
 </Grid.Resources>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="224"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="{ThemeResource SidebarBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="0,0,1,0">
   <local:DockPanel Margin="14,0">
    <StackPanel local:DockPanel.Dock="Top" Margin="8,26,0,23">
     <StackPanel Orientation="Horizontal"><Border Width="32" Height="32" CornerRadius="9" Background="{ThemeResource AccentBrush}"><TextBlock Text="H2" Foreground="{ThemeResource AccentTextBrush}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border><StackPanel Margin="10,0,0,0"><TextBlock Text="HS2 Manager" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="人物卡资源库" FontSize="10" Foreground="{ThemeResource MutedBrush}" Margin="0,3,0,0"/></StackPanel></StackPanel>
    </StackPanel>
    <StackPanel local:DockPanel.Dock="Bottom" Margin="4,12,4,16">
     <Border BorderBrush="{ThemeResource BorderBrush}" BorderThickness="0,1,0,0" Padding="4,14,0,12"><StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="●" Foreground="{ThemeResource SuccessBrush}" FontSize="9" VerticalAlignment="Center" Margin="0,0,7,0"/><TextBlock Text="{Binding GameConnection}" FontSize="11"/></StackPanel><TextBlock Text="{Binding GameFolderName}" FontSize="10" Foreground="{ThemeResource MutedBrush}" Margin="16,5,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></Border>
     <ComboBox ItemsSource="{Binding ThemeChoices}" SelectedItem="{Binding ThemeChoice, Mode=TwoWay}" FontSize="12" Margin="0,0,0,8" AutomationProperties.Name="应用主题"/>
     <Button Content="⚙  设置与连接" Style="{StaticResource QuietButton}" HorizontalContentAlignment="Left" Click="Settings_Click"/>
    </StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel>
      <Button Tag="all" Click="Navigate_Click" Style="{StaticResource NavButton}"><local:DockPanel><TextBlock Text="{Binding TotalCount}" local:DockPanel.Dock="Right" Foreground="{ThemeResource MutedBrush}" FontSize="11" VerticalAlignment="Center"/><TextBlock Text="▦   全部人物卡"/></local:DockPanel></Button>
      <Button Tag="favorites" Click="Navigate_Click" Style="{StaticResource NavButton}"><local:DockPanel><TextBlock Text="{Binding FavoriteCount}" local:DockPanel.Dock="Right" Foreground="{ThemeResource MutedBrush}" FontSize="11" VerticalAlignment="Center"/><TextBlock Text="☆   我的收藏"/></local:DockPanel></Button>
      <Button Tag="duplicates" Click="Duplicates_Click" Style="{StaticResource NavButton}" IsEnabled="{Binding IsIdle}"><local:DockPanel><TextBlock Text="{Binding DuplicateCount}" local:DockPanel.Dock="Right" Foreground="{ThemeResource MutedBrush}" FontSize="11"/><TextBlock Text="▣   重复文件"/></local:DockPanel></Button>
      <Button Tag="issues" Click="Navigate_Click" Style="{StaticResource NavButton}"><local:DockPanel><TextBlock Text="{Binding IssueCount}" local:DockPanel.Dock="Right" Foreground="{ThemeResource MutedBrush}" FontSize="11"/><TextBlock Text="ⓘ   需要关注"/></local:DockPanel></Button>
      <Button Tag="trash" Click="Navigate_Click" Style="{StaticResource NavButton}"><local:DockPanel><TextBlock Text="{Binding TrashCount}" local:DockPanel.Dock="Right" Foreground="{ThemeResource MutedBrush}" FontSize="11"/><TextBlock Text="↶   可恢复隔离区"/></local:DockPanel></Button>
      <Grid Margin="12,22,4,6"><TextBlock Text="虚拟分类" Foreground="{ThemeResource MutedBrush}" FontSize="11" VerticalAlignment="Center"/><Button Content="＋" HorizontalAlignment="Right" Padding="6,2" Style="{StaticResource QuietButton}" Click="NewCollection_Click" ToolTipService.ToolTip="新建虚拟分类"/></Grid>
      <ListView x:Name="CollectionList" ItemsSource="{Binding Collections}" SelectionChanged="Collection_SelectionChanged" FontSize="12" MinHeight="22"><ListView.ContextFlyout><MenuFlyout><MenuFlyoutItem Text="重命名分类" Click="RenameCollection_Click"/><MenuFlyoutItem Text="删除分类（保留人物卡）" Click="RemoveCollection_Click"/></MenuFlyout></ListView.ContextFlyout></ListView>
      <TextBlock Text="文件夹" Style="{StaticResource SectionLabel}"/>
      <TreeView x:Name="FolderTree" ItemsSource="{Binding Folders}" ItemTemplate="{StaticResource FolderTemplate}" SelectionMode="Single" SelectionChanged="Folder_Selected" Margin="3,0,0,16"/>
     </StackPanel>
    </ScrollViewer>
   </local:DockPanel>
  </Border>
  <Grid Grid.Column="1">
   <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="34"/></Grid.RowDefinitions>
   <Grid Visibility="{Binding IsPreview, Converter={StaticResource BoolVisible}, ConverterParameter=Invert}">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid Margin="28,25,26,19"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding PageTitle}" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="{Binding LibrarySummary}" Foreground="{ThemeResource MutedBrush}" FontSize="12" Margin="1,8,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="↻  刷新" Margin="0,0,10,0" Click="Refresh_Click" IsEnabled="{Binding IsIdle}"/><Button Content="＋  导入人物卡" Style="{StaticResource PrimaryButton}" Click="Import_Click" IsEnabled="{Binding IsIdle}"/></StackPanel></Grid>
    <Grid Grid.Row="1" Margin="28,0,26,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="124"/><ColumnDefinition Width="116"/></Grid.ColumnDefinitions>
     <Grid Margin="0,0,12,0"><TextBox x:Name="SearchBox" PlaceholderText="搜索名称、文件名、标签…" Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="搜索人物卡" Padding="12,9"/></Grid>
     <ComboBox Grid.Column="1" ItemsSource="{Binding GenderChoices}" SelectedItem="{Binding GenderFilter, Mode=TwoWay}" Margin="0,0,8,0" AutomationProperties.Name="性别筛选"/>
     <ComboBox Grid.Column="2" ItemsSource="{Binding Tags}" SelectedItem="{Binding TagFilter, Mode=TwoWay}" Margin="0,0,8,0" AutomationProperties.Name="标签筛选"/>
     <ComboBox Grid.Column="3" ItemsSource="{Binding SortChoices}" SelectedItem="{Binding SortOrder, Mode=TwoWay}" AutomationProperties.Name="排序方式"/>
    </Grid>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
     <Grid Margin="18,0,12,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock Text="{Binding ResultSummary}" Foreground="{ThemeResource MutedBrush}" FontSize="11" Margin="12,0,0,9"/>
      <GridView x:Name="CardList" Grid.Row="1" ItemsSource="{Binding VisibleCards}" ItemTemplate="{StaticResource CardTemplate}" ItemContainerStyle="{StaticResource CardContainer}" SelectionMode="Extended" SelectionChanged="Cards_SelectionChanged" DoubleTapped="Cards_DoubleClick" RightTapped="Cards_RightClick" AutomationProperties.Name="人物卡网格">
       <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid ItemWidth="190" ItemHeight="310" Orientation="Horizontal"/></ItemsPanelTemplate></GridView.ItemsPanel>
       <GridView.ContextFlyout><MenuFlyout><MenuFlyoutItem Text="打开 3D 预览" Click="Preview_Click"/><MenuFlyoutItem Text="收藏 / 取消收藏" Click="BatchFavorite_Click"/><MenuFlyoutSeparator/><MenuFlyoutItem Text="添加标签…" Click="BatchTags_Click"/><MenuFlyoutItem Text="加入虚拟分类…" Click="AssignCollection_Click"/><MenuFlyoutItem Text="导出原始 PNG…" Click="Export_Click"/><MenuFlyoutItem Text="移动到文件夹…" Click="Move_Click"/><MenuFlyoutItem Text="重命名…" Click="Rename_Click"/><MenuFlyoutSeparator/><MenuFlyoutItem Text="在资源管理器中显示" Click="Reveal_Click"/><MenuFlyoutItem Text="移入可恢复隔离区…" Click="Quarantine_Click"/></MenuFlyout></GridView.ContextFlyout>
      </GridView>
      <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding Empty, Converter={StaticResource BoolVisible}}" MaxWidth="350"><TextBlock Text="▧" FontSize="44" Foreground="{ThemeResource MutedBrush}" HorizontalAlignment="Center"/><TextBlock Text="这里还没有人物卡" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,18,0,8"/><TextBlock Text="调整筛选条件，或拖入 PNG 人物卡开始整理。" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center"/></StackPanel>
      <Border Grid.Row="2" Background="{ThemeResource SurfaceBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="8" Margin="8,8,8,12" Visibility="{Binding HasSelection, Converter={StaticResource BoolVisible}}"><local:WrapPanel><Button IsEnabled="{Binding CanModify}" Content="☆ 收藏" Style="{StaticResource QuietButton}" Click="BatchFavorite_Click"/><Button IsEnabled="{Binding CanModify}" Content="标签" Style="{StaticResource QuietButton}" Click="BatchTags_Click"/><Button IsEnabled="{Binding CanModify}" Content="分类" Style="{StaticResource QuietButton}" Click="AssignCollection_Click"/><Button IsEnabled="{Binding CanModify}" Content="导出" Style="{StaticResource QuietButton}" Click="Export_Click"/><Button IsEnabled="{Binding CanModify}" Content="更多 ⋯" Style="{StaticResource QuietButton}" Click="More_Click"/><Button IsEnabled="{Binding CanModify}" Content="恢复" Style="{StaticResource QuietButton}" Click="Restore_Click" Visibility="{Binding IsTrash, Converter={StaticResource BoolVisible}}"/></local:WrapPanel></Border>
     </Grid>
     <Border Grid.Column="1" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1,0,0,0" Background="{ThemeResource SurfaceBrush}">
      <Grid>
       <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="218" Visibility="{Binding SelectedCard, Converter={StaticResource NullVisible}, ConverterParameter=Invert}"><TextBlock Text="◈" FontSize="32" Foreground="{ThemeResource MutedBrush}" HorizontalAlignment="Center"/><TextBlock Text="选择一张人物卡" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,17,0,8"/><TextBlock Text="查看角色信息、管理标签，或打开真实 3D 预览。" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center" LineHeight="22"/></StackPanel>
       <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding SelectedCard, Converter={StaticResource NullVisible}}">
        <StackPanel Margin="22,18,22,24">
         <Grid><TextBlock Text="人物详情" FontSize="11" Foreground="{ThemeResource MutedBrush}"/><TextBlock Text="{Binding SelectedCard.Status}" FontSize="10" Foreground="{ThemeResource SuccessBrush}" HorizontalAlignment="Right"/></Grid>
         <Border Background="{ThemeResource SidebarBrush}" CornerRadius="8" Margin="0,18,0,14" Height="210"><Image Source="{Binding SelectedCard.Cover}" Stretch="Uniform"/></Border>
         <TextBlock Text="{Binding SelectedCard.Name}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
         <TextBlock Text="{Binding SelectedCard.Subtitle}" FontSize="11" Foreground="{ThemeResource MutedBrush}" Margin="0,7,0,16"/>
         <Button Content="◈  打开 3D 预览" Style="{StaticResource PrimaryButton}" Click="Preview_Click" IsEnabled="{Binding CanPreview}" Padding="12,11"/>
         <Button Content="{Binding FavoriteText}" Click="Favorite_Click" Margin="0,8,0,0" IsEnabled="{Binding CanModify}"/>
         <Border Height="1" Background="{ThemeResource BorderBrush}" Margin="0,12"/>
         <TextBlock Text="标签" FontSize="11" Foreground="{ThemeResource MutedBrush}" Margin="0,0,0,6"/><TextBox Text="{Binding EditTags, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTipService.ToolTip="多个标签用逗号分隔" AutomationProperties.Name="人物标签"/>
         <TextBlock Text="备注" FontSize="11" Foreground="{ThemeResource MutedBrush}" Margin="0,14,0,6"/><TextBox Text="{Binding EditNotes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="76" TextWrapping="Wrap" AcceptsReturn="True" ScrollViewer.VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" AutomationProperties.Name="人物备注"/>
         <Button Content="保存标签与备注" Click="SaveDetails_Click" Margin="0,8,0,0" IsEnabled="{Binding CanModify}"/>
         <Border Height="1" Background="{ThemeResource BorderBrush}" Margin="0,12"/>
         <TextBlock Text="文件信息" FontSize="11" Foreground="{ThemeResource MutedBrush}" Margin="0,0,0,9"/>
         <TextBlock Text="{Binding SelectedCard.DetailLine}" FontSize="12" TextWrapping="Wrap"/>
         <TextBlock Text="{Binding SelectedCard.Modified}" FontSize="11" Foreground="{ThemeResource MutedBrush}" Margin="0,8,0,0"/>
         <TextBlock Text="{Binding SelectedCard.Folder}" FontSize="11" Foreground="{ThemeResource MutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
         <TextBlock Text="{Binding SelectedCard.Record.Error}" FontSize="11" Foreground="{ThemeResource WarningBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
         <Button Content="在资源管理器中显示 ↗" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Padding="0,10" Click="Reveal_Click"/>
         <Border Height="1" Background="{ThemeResource BorderBrush}" Margin="0,12"/>
         <local:DockPanel><Button Content="更新" local:DockPanel.Dock="Right" Style="{StaticResource QuietButton}" Padding="5,0" Click="Mods_Click" IsEnabled="{Binding IsIdle}"/><TextBlock Text="MOD 与扩展数据" FontSize="11" Foreground="{ThemeResource MutedBrush}"/></local:DockPanel>
         <TextBlock Text="{Binding DependencySummary}" Foreground="{ThemeResource MutedBrush}" FontSize="10" Margin="0,7,0,10"/>
         <ItemsControl ItemsSource="{Binding DetailDependencies}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{ThemeResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,9"><StackPanel><TextBlock Text="{Binding Label}" Foreground="{Binding Color}" FontSize="10"/><TextBlock Text="{Binding Guid}" TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0"/><TextBlock Text="{Binding Detail}" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap" FontSize="10" Margin="0,4,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </StackPanel>
       </ScrollViewer>
      </Grid>
     </Border>
    </Grid>
   </Grid>
   <Grid Visibility="{Binding IsPreview, Converter={StaticResource BoolVisible}}" Margin="24,20,24,12">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <local:DockPanel Margin="0,0,0,18"><StackPanel local:DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="人物列表" Style="{StaticResource QuietButton}" Click="ToggleRail_Click"/><Button Content="保存截图" Margin="10,0,0,0" Click="Screenshot_Click"/></StackPanel><Grid Margin="0,0,12,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button Content="←" Style="{StaticResource QuietButton}" FontSize="20" Padding="0,5,14,5" Click="ClosePreview_Click" ToolTipService.ToolTip="关闭预览并返回资源库"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding PreviewName}" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding PreviewFileName}" ToolTipService.ToolTip="{Binding PreviewFilePath}" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource MutedBrush}" FontSize="11" Margin="0,3,0,0"/></StackPanel></Grid></local:DockPanel>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border Width="190" Margin="0,0,14,0" Visibility="{Binding ShowPreviewRail, Converter={StaticResource BoolVisible}}"><ListView x:Name="PreviewRail" ItemsSource="{Binding VisibleCards}" SelectionChanged="PreviewRail_Selected"><ListView.ItemTemplate><DataTemplate><Grid Margin="2,4" ToolTipService.ToolTip="{Binding Record.Path}"><Grid.ColumnDefinitions><ColumnDefinition Width="45"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border CornerRadius="5" Background="{ThemeResource SidebarBrush}" Height="62"><Image Source="{Binding Cover}" Stretch="Uniform"/></Border><StackPanel Grid.Column="1" Margin="9,3,0,0"><TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding DetailLine}" TextWrapping="Wrap" FontSize="10" Foreground="{ThemeResource MutedBrush}" Margin="0,6,0,0"/></StackPanel></Grid></DataTemplate></ListView.ItemTemplate></ListView></Border>
     <Border Grid.Column="1" Background="#10151B" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="10">
      <Grid x:Name="Viewport" Background="{Binding PreviewBackground}" SizeChanged="Viewport_SizeChanged" PointerPressed="Viewport_MouseDown" PointerReleased="Viewport_MouseUp" PointerCanceled="Viewport_MouseUp" PointerCaptureLost="Viewport_MouseUp" PointerMoved="Viewport_MouseMove" PointerWheelChanged="Viewport_MouseWheel" DoubleTapped="Viewport_DoubleTapped">
       <local:UnityPreviewViewport x:Name="NativeViewport" Session="{Binding UnitySession}" IsHitTestVisible="False"/>
       <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding PreviewBusy, Converter={StaticResource BoolVisible}}"><TextBlock Text="正在准备人物预览" Foreground="#E9EDEB" FontSize="18" HorizontalAlignment="Center"/><ProgressBar IsIndeterminate="True" Width="180" Height="3" Margin="0,20,0,15" Foreground="#9BB6A3" Background="#2E3834"/><TextBlock Text="{Binding PreviewStatus}" Foreground="#A9B2B5" MaxWidth="380" TextWrapping="Wrap" TextAlignment="Center"/></StackPanel>
       <Border Background="#E510151B" Visibility="{Binding HasPreviewError, Converter={StaticResource BoolVisible}}"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440" Margin="20"><TextBlock Text="预览暂时不可用" Foreground="#EDF0EB" FontSize="20" HorizontalAlignment="Center"/><TextBlock Text="{Binding PreviewError}" Foreground="#B8C0BA" TextWrapping="Wrap" TextAlignment="Center" Margin="0,16,0,20"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Button Content="重试" Click="RetryPreview_Click" Margin="0,0,8,0"/><Button Content="查看日志" Click="Logs_Click"/></StackPanel></StackPanel></Border>
      </Grid>
     </Border>
    </Grid>
    <StackPanel Grid.Row="2" Margin="0,14,0,0"><local:DockPanel><StackPanel Orientation="Horizontal" local:DockPanel.Dock="Right"><Button Content="恢复游戏环境" Click="RestoreEnvironment_Click" Style="{StaticResource QuietButton}" Margin="0,0,8,0"/><TextBlock Text="灯光" Foreground="{ThemeResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/><Slider x:Name="LightSlider" Minimum="0.2" Maximum="2" Value="{Binding PreviewLightIntensity, Mode=TwoWay}" Width="100" VerticalAlignment="Center" ToolTipService.ToolTip="相对游戏灯光强度；1 为原始亮度"/><ComboBox x:Name="BackgroundChoice" Width="106" Margin="12,0,0,0" SelectedIndex="{Binding PreviewBackgroundIndex, Mode=TwoWay}"><ComboBoxItem Content="游戏背景"/><ComboBoxItem Content="深色背景"/><ComboBoxItem Content="灰色背景"/><ComboBoxItem Content="浅色背景"/></ComboBox></StackPanel><local:WrapPanel><Button Content="正面" Tag="0" Click="Angle_Click" Style="{StaticResource QuietButton}"/><Button Content="侧面" Tag="90" Click="Angle_Click" Style="{StaticResource QuietButton}"/><Button Content="背面" Tag="180" Click="Angle_Click" Style="{StaticResource QuietButton}"/><Button Content="面部" Click="FocusFace_Click" Style="{StaticResource QuietButton}"/><Button Content="复位镜头" Click="ResetCamera_Click" Style="{StaticResource QuietButton}"/><Button Content="{Binding PlaybackLabel}" Click="Playback_Click" Style="{StaticResource QuietButton}"/></local:WrapPanel></local:DockPanel><TextBlock Text="{Binding PreviewStatus}" Foreground="{ThemeResource MutedBrush}" FontSize="10" Margin="3,8,0,0"/><TextBlock Text="{Binding PreviewLimitations}" Foreground="{ThemeResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="3,8,0,0"/><Expander Header="预览兼容性说明（查看详情）" Visibility="{Binding HasPreviewWarnings, Converter={StaticResource BoolVisible}}" Foreground="{ThemeResource TextBrush}" Margin="0,5,0,0"><ScrollViewer MaxHeight="90" VerticalScrollBarVisibility="Auto"><TextBlock Text="{Binding PreviewWarnings}" FontSize="11" TextWrapping="Wrap" Margin="6"/></ScrollViewer></Expander></StackPanel>
   </Grid>
   <Grid Grid.Row="1" Background="{ThemeResource SidebarBrush}" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisible}}" Margin="0"><Grid.RowDefinitions><RowDefinition Height="3"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ProgressBar Value="{Binding ProgressValue, Mode=OneWay}" IsIndeterminate="{Binding ProgressIndeterminate}" Height="3" Foreground="{ThemeResource SuccessBrush}" Background="Transparent" BorderThickness="0"/><local:DockPanel Grid.Row="1" Margin="20,5"><Button Content="取消" local:DockPanel.Dock="Right" Style="{StaticResource QuietButton}" Padding="10,3" Click="Cancel_Click"/><TextBlock Text="{Binding WorkLabel}" FontSize="11" Foreground="{ThemeResource MutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></local:DockPanel></Grid>
   <Border Grid.Row="2" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="0,1,0,0"><local:DockPanel Margin="22,0"><Button Content="操作日志" local:DockPanel.Dock="Right" Style="{StaticResource QuietButton}" FontSize="10" Padding="7,3" Click="Operations_Click"/><TextBlock Text="{Binding Status}" Foreground="{ThemeResource MutedBrush}" FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></local:DockPanel></Border>
  </Grid>
 </Grid>
 </Grid>
</Window>

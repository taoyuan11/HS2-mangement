<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../HS2Manager.Core/HS2Manager.Core.csproj" /></ItemGroup>
  <ItemGroup><ProjectReference Include="../HS2Manager.Rendering/HS2Manager.Rendering.csproj" /></ItemGroup>
  <PropertyGroup>
    <NativeFbxDirectory Condition="'$(NativeFbxDirectory)'==''">$(LOCALAPPDATA)\HS2Manager\NativeBuild\Fbx-2020.3.7\Release</NativeFbxDirectory>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="$(NativeFbxDirectory)\HS2Manager.FbxBridge.dll;$(NativeFbxDirectory)\libfbxsdk.dll" Condition="Exists('$(NativeFbxDirectory)\HS2Manager.FbxBridge.dll')" Link="native\win-x64\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

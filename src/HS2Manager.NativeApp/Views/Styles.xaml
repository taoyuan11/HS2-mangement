<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
    <SolidColorBrush x:Key="PageBrush" Color="#FAFAF9"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#F1F1EF"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#EAEAE7"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#E3E3DF"/>
    <SolidColorBrush x:Key="TextBrush" Color="#242723"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#62685F"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#282E29"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SelectedBrush" Color="#E1E8DE"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#438464"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#A26D24"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#B42318"/>
    <!-- 保留系统控件的键盘焦点、悬停、按下与禁用状态，只统一尺寸和排版。 -->
    <Style TargetType="Button">
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="ToggleButton">
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="TextBox">
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Padding" Value="16,6"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style x:Key="QuietButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style x:Key="ToolbarButton" TargetType="Button">
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
        <Setter Property="Foreground" Value="{ThemeResource DangerBrush}"/>
    </Style>
    <Style x:Key="ActionIcon" TargetType="FontIcon">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Width" Value="20"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>
    <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="Margin" Value="0,2"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="CornerRadius" Value="6"/>
    </Style>
    <Style x:Key="SectionLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource MutedBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Margin" Value="12,20,0,8"/>
    </Style>
    <Style x:Key="PanelSection" TargetType="Expander">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="12"/>
    </Style>
</ResourceDictionary>

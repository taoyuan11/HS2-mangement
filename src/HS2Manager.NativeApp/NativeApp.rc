#include <windows.h>
#include "AppVersion.h"

IDI_APP_ICON ICON "Assets\\Brand\\hs2-manager.ico"

VS_VERSION_INFO VERSIONINFO
    FILEVERSION HS2_FILE_VERSION
    PRODUCTVERSION HS2_FILE_VERSION
    FILEFLAGSMASK 0x3fL
    FILEFLAGS 0
    FILEOS VOS_NT_WINDOWS32
    FILETYPE VFT_APP
    FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "HS2 Manager\0"
            VALUE "FileVersion", HS2_FILE_VERSION_STRING "\0"
            VALUE "InternalName", "HS2Manager\0"
            VALUE "OriginalFilename", "HS2Manager.exe\0"
            VALUE "ProductName", "HS2 Manager\0"
            VALUE "ProductVersion", HS2_VERSION "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
